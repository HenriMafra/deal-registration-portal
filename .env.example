# ===== MAPPER — Registro de Oportunidade (RO) — variáveis de ambiente =====
# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca versione o .env.local. Service role e DB URL NUNCA vão para o frontend.

# --- Supabase do projeto RO (hgczpdwhjqaqiravorrg), PÚBLICAS (usadas no browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_publica

# --- Supabase (SECRETAS, apenas no servidor / API routes) ---
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_SECRETA

# --- Conexão direta ao Postgres (usada só por scripts administrativos, se houver) ---
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Modo do site (fixo — este repo só serve o produto RO) ---
NEXT_PUBLIC_SITE_MODE=ro

# --- Bitrix (integração opcional do fluxo de RO, ver app/api/bitrix-ro) ---
BITRIX_WEBHOOK_URL=

# --- CNPJ (consulta de dados do órgão/empresa no formulário de RO) ---
# ver app/api/cnpj — normalmente usa a BrasilAPI pública, sem chave.

# --- Selo de build exibido no rodapé/versão (opcional, gerado pelo script de deploy) ---
NEXT_PUBLIC_BUILD_STAMP=
